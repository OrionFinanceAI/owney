# RPC (Sepolia)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# SEPOLIA_RPC_URL=...   # alias for RPC_URL

# Orion
ORION_CONFIG_ADDRESS=0xbDe3025d08681a02a1c6cf70375baBe2152DD06f
# DRY_RUN=1

# Owney keepers (docker: owney:usdc | owney:weth)
# USDC/WETH are simulation denominations (multi-product baskets), not binary allocation.
OWNEY_USDC_VAULT_ADDRESS=0x...
OWNEY_WETH_VAULT_ADDRESS=0x...
OWNEY_STRATEGIST_PRIVATE_KEY=0x...
OWNEY_API_KEY=
# OWNEY_MOCK=1
# OWNEY_SIM_AMOUNT=10000
# OWNEY_SIM_STRATEGY=aggressive
# OWNEY_SIM_MIN_SPLIT=1
# OWNEY_HTTP_TIMEOUT_MS=60000
# OWNEY_MAX_RETRIES=3
# OWNEY_USDC_TOKEN=0x...       # optional idle USDC replica override
# OWNEY_WETH_TOKEN=0x...
